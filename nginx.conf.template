load_module modules/ngx_http_js_module.so;

events {
    worker_connections 1024;
}

env ALLOWED_METHODS;
env BACKEND_HOST;
env TRUSTED_PROXY;

error_log stderr warn;

http {
    js_import jsonrpc from /etc/nginx/jsonrpc-filter.js;

    # Set real IP from proxy
    set_real_ip_from ${TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;

    # Increase buffer sizes for subrequests
    subrequest_output_buffer_size 50m;

    log_format with_post_data '$remote_addr -> $upstream_addr -  $remote_user [$time_local] "$request" '
                              '$status $body_bytes_sent "$http_referer" '
                              '"$http_user_agent" "$http_x_forwarded_for" "POST DATA: $request_body"';

    server {
        listen 80;
        server_name _;

        access_log /dev/stdout with_post_data;

        location / {
            # Call njs function to check the request
            js_content jsonrpc.filterRequest;
        }

        # Internal location for backend proxy
        location /_backend {
            internal;
            proxy_pass http://${BACKEND_HOST}/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Content-Type application/json;
        }
    }
}
